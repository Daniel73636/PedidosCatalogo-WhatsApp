NODE_ENV=development
DATABASE_URL=postgres://pedidos:pedidos@localhost:5432/pedidos
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Orígenes exactos de la web, separados por coma. En producción, HTTPS.
WEB_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_* se incrustan al hacer pnpm build, no al arrancar.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mínimo 32 caracteres. En producción no usar el valor de desarrollo ni este ejemplo.
JWT_SECRET=cambie-por-un-secreto-aleatorio-de-32-caracteres
# true ignora DATABASE_URL y vuelve a memoria. Lanzamiento: false.
DEMO_MODE=false
# DEMO_ADMIN_KEY=solo-si-demo-mode-esta-activo
# API_KEYS=tenant-uuid:sha256-de-la-clave:orders:read|orders:write
PAYMENTS_PROVIDER=mock
PAYMENT_WEBHOOK_ENABLED=false
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_WEBHOOK_SECRET=minimo-16-caracteres
WHATSAPP_CLOUD_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WORKER_INTERVAL_MS=60000
